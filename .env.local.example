# URL du projet Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=

# Clé publique anon Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé service_role Supabase (Project Settings > API) — SERVEUR UNIQUEMENT,
# ne jamais la préfixer par NEXT_PUBLIC_. Requise pour le mot de passe oublié.
SUPABASE_SERVICE_ROLE_KEY=

# URL publique du site, utilisée dans les liens des e-mails
# (ex. https://sama-cahier.com en production, http://localhost:3000 en local)
NEXT_PUBLIC_SITE_URL=

# Clé API Resend, pour l'envoi d'emails transactionnels (resend.com/api-keys)
RESEND_API_KEY=
